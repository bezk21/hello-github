{
  "_说明": "本地数据同步配置。把你的数据底表放进 input_dir 目录，脚本会自动扫描所有 sheet 并按 columns 别名匹配各板块。改完本文件无需改代码。",
  "input_dir": "data",
  "file_glob": "*.xlsx",
  "extra_globs": ["*.xls", "*.csv"],
  "header_row": 1,
  "min_match": 2,
  "output_js": "data.js",
  "log_file": "sync.log",
  "finance_default_budget": 500000,
  "budget_row_keyword": "总预算",
  "tables": {
    "kpi": {
      "_说明": "总控台品牌指标：指标 / 当期值 / 目标值",
      "required": ["指标"],
      "columns": {
        "指标": ["指标", "指标名称", "metric", "KPI指标", "数据项"],
        "当期值": ["当期值", "实际值", "实际", "本期", "当前值", "数值", "actual"],
        "目标值": ["目标值", "目标", "KPI", "目标数", "target"]
      }
    },
    "trend": {
      "_说明": "趋势数据：月份 / 搜索量 / 小红星GMV",
      "required": ["月份"],
      "columns": {
        "月份": ["月份", "日期", "时间", "统计周期", "周", "month", "date"],
        "搜索量": ["搜索量", "搜索指数", "搜索", "搜索人数", "search"],
        "小红星GMV": ["小红星GMV", "GMV", "成交金额", "支付金额", "成交GMV", "gmv"]
      }
    },
    "accounts": {
      "_说明": "聚光各子账户表现。左边是工作台字段，右边数组是你的底表可能用的列名，命中任意一个即可。",
      "required": ["子账户", "消耗"],
      "columns": {
        "子账户": ["子账户", "账户名称", "账户", "广告账户", "推广账户", "计划名称", "账户ID", "account"],
        "消耗": ["消耗", "花费", "消费", "消耗金额", "成本", "spend", "cost"],
        "展现": ["展现", "展现量", "曝光", "曝光量", "展示量", "impression"],
        "点击": ["点击", "点击量", "点击数", "click"],
        "互动量": ["互动量", "互动", "互动数", "互动次数", "engagement"],
        "加购": ["加购", "加购数", "加购量", "收藏加购"],
        "成交GMV": ["成交GMV", "GMV", "成交金额", "支付金额", "下单金额", "小红星GMV"]
      }
    },
    "finance": {
      "_说明": "财务预算：项目 / 预算 / 已消耗。含『总预算』关键字的行会被识别为当月总预算。",
      "required": ["项目"],
      "columns": {
        "项目": ["项目", "项目名称", "类型", "分类", "费用项", "project"],
        "预算": ["预算", "预算金额", "月度预算", "计划金额", "budget"],
        "已消耗": ["已消耗", "消耗", "累计消耗", "实际消耗", "花费", "spent"]
      }
    },
    "todos": {
      "_说明": "当月待办：流程 / 事项 / 计划时间点 / 负责人 / 状态 / 备注。若底表无此板块，页面保留原有待办不变。",
      "required": ["事项"],
      "columns": {
        "流程": ["流程", "流程名称", "所属流程", "类别"],
        "事项": ["事项", "任务", "待办事项", "待办", "工作内容", "task"],
        "计划时间点": ["计划时间点", "时间点", "截止时间", "计划时间", "deadline", "日期"],
        "负责人": ["负责人", "责任人", "经办人", "owner"],
        "状态": ["状态", "进度", "完成情况", "status"],
        "备注": ["备注", "说明", "备注说明", "note"]
      }
    }
  }
}
